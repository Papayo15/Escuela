# Clave de OpenRouter. Solo se usa en el servidor para CEVS.
OPENROUTER_API_KEY=
# Opcional: modelos separados por coma, en orden de preferencia
OPENROUTER_MODELS=
# Conexión de Neon. Vacío en local: la biblioteca vive en memoria
DATABASE_URL=
# Código mensual del plan biblioteca
ACCESS_CODE=
# Código mensual del plan completo: biblioteca, CEVS y fotos
PREMIUM_CODE=
# Cadena larga y aleatoria: openssl rand -hex 32
COOKIE_SECRET=
# Progreso del alumno (apodo, PIN, racha). Apagado: déjalo vacío. Encendido: 1.
# Antes de encenderlo, revisa el aviso de privacidad con tu asesor: guarda datos de menores.
PROGRESO_ACTIVO=
# Correo que recibe los reportes de errores
CORREO_ESCUELA=
