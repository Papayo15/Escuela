# Clave de OpenRouter. Solo se usa en el servidor para el Maestro en vivo.
OPENROUTER_API_KEY=
# Opcional: modelos separados por coma, en orden de preferencia
OPENROUTER_MODELS=
# Conexión de Neon. Vacío en local: la biblioteca vive en memoria
DATABASE_URL=
# Código mensual del plan biblioteca
ACCESS_CODE=
# Código mensual del plan completo: biblioteca, Maestro en vivo y fotos
PREMIUM_CODE=
# Cadena larga y aleatoria: openssl rand -hex 32
COOKIE_SECRET=
# Correo que recibe los reportes de errores
CORREO_ESCUELA=
